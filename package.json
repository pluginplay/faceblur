{
  "name": "pluginplay.faceblur",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "tsc && vite build --watch true",
    "check:repo:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:native:build": "node scripts/check-native-for-build.mjs",
    "prebuild": "yarn check:repo:hygiene && yarn check:native:build",
    "build": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && vite build --watch false",
    "build:mac": "yarn native:mac && yarn build",
    "build:win": "node scripts/build-native-windows.mjs",
    "build:native": "cmake -S cpp -B cpp/build -DCMAKE_BUILD_TYPE=Release -DFACE_PIPELINE_ENABLE_GMC=OFF && cmake --build cpp/build -j 4",
    "stage:native:mac": "cmake --install cpp/build --prefix src/bin && bash scripts/stage-native-macos.sh src/bin/face_pipeline src/bin",
    "native:mac": "yarn build:native && yarn stage:native:mac && node scripts/verify-native-bundle.mjs --target macos && if [ \"${MAC_NATIVE_SIGN:-0}\" = \"1\" ]; then yarn sign:native:mac; fi && if [ \"${MAC_NATIVE_NOTARIZE:-0}\" = \"1\" ]; then yarn notarize:native:mac; fi",
    "native:mac:release": "MAC_NATIVE_SIGN=1 MAC_NATIVE_NOTARIZE=1 yarn native:mac && yarn verify:mac:dist",
    "stage:native:win": "node scripts/stage-native-windows.mjs src/bin/face_pipeline.exe src/bin",
    "sign:native:mac": "bash scripts/sign-macos-native.sh src/bin",
    "notarize:native:mac": "bash scripts/notarize-macos-native.sh src/bin",
    "sign:native:win": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows-native.ps1 -TargetDir src/bin",
    "verify:native": "node scripts/verify-native-bundle.mjs --target host",
    "verify:native:all": "node scripts/verify-native-bundle.mjs --target all",
    "verify:mac:dist": "node scripts/verify-macos-distribution.mjs --app src/bin/face_pipeline.app",
    "prezxp": "yarn verify:native",
    "zxp": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZXP_PACKAGE=true vite build --watch false",
    "zip": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZIP_PACKAGE=true vite build --watch false",
    "serve": "cross-env SERVE_PANEL=true vite preview",
    "symlink": "cross-env BOLT_ACTION=symlink vite",
    "delsymlink": "cross-env BOLT_ACTION=delsymlink vite"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "lucide-react": "^0.576.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.19.0",
    "@babel/plugin-proposal-class-properties": "^7.16.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.16.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.16.4",
    "@babel/preset-env": "^7.19.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.16.0",
    "@babel/runtime": "^7.16.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^16.11.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/trusted-types": "^2.0.2",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-require": "^4.0.3",
    "babel-plugin-transform-scss": "^1.2.0",
    "babel-preset-env": "^1.7.0",
    "core-js": "3",
    "cross-env": "^7.0.3",
    "fs-extra": "^10.0.0",
    "postcss": "^8.5.6",
    "rimraf": "^3.0.2",
    "rollup": "^4.42.0",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-node-copy": "^1.0.4",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.89.1",
    "source-map": "^0.7.4",
    "tailwindcss": "3",
    "types-for-adobe": "^7.2.3",
    "types-for-adobe-extras": "^0.0.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-cep-plugin": "^2.1.1"
  }
}
